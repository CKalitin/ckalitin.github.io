---
import yaml from 'js-yaml';
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

const yamlPath = path.resolve('src/data/appearances.yaml');
const raw = fs.readFileSync(yamlPath, 'utf-8');
const parsed = (yaml.load(raw) as { date: string; link: string; text: string }[] | null) ?? [];
const appearances = [...parsed].sort((a, b) => (a.date < b.date ? 1 : -1));
---
<BaseLayout title="Appearances — Christopher Kalitin Blog">
  <main>
    <div class="chrono-list">
      {appearances.length === 0 && <p class="post-body">No appearances listed yet.</p>}
      {appearances.map((item) => (
        <a href={item.link} class="chrono-row" target="_blank" rel="noopener noreferrer">
          <span class="date">{new Date(item.date + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
          <span class="title">{item.text}</span>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
